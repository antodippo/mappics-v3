# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is git-ignored; never commit real project IDs or bucket names.

project_id            = "your-gcp-project-id"
region                = "europe-west1"
firestore_location    = "europe-west1"
source_bucket_name    = "mappics-source-yourproject"    # must be globally unique
processed_bucket_name = "mappics-processed-yourproject" # must be globally unique

github_repository     = "your-github-username/mappics-v3"  # owner/repo format, used for Workload Identity Federation

# Monitoring — receives uptime, 5xx, import-failure and budget alerts
alert_email = "you@example.com"

# Optional — defaults to project_id if omitted
# firebase_site_id    = "mappics-yourproject"

# Optional — enables the monthly budget alert. Budgets live on the billing
# account, so this needs roles/billing.costsManager there (see README).
#   gcloud billing projects describe <project_id> --format='value(billingAccountName)'
# billing_account_id    = "0X0X0X-0X0X0X-0X0X0X"
# monthly_budget_amount = 10
# budget_currency       = "EUR"   # must match the billing account currency
