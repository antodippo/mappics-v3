# Production environment variables for the Spring Boot backend.
# In production these are set in the Cloud Run service definition (via Terraform).
# For local prod-profile testing: copy to .env, fill in values, and export before running.
#
# Usage (local):
#   export $(cat .env | xargs)
#   cd backend && ./mvnw spring-boot:run -Dspring-boot.run.profiles=prod

# ── GCP ───────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id

# ── Cloud Storage ─────────────────────────────────────────────────────────────
# Name of the bucket containing original uploaded JPEGs (private, one folder = one gallery)
MAPPICS_SOURCE_BUCKET=mappics-source-your-project

# Name of the bucket serving resized images to the frontend (public read)
MAPPICS_PROCESSED_BUCKET=mappics-processed-your-project

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
