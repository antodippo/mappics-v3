<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.antodippo</groupId>
    <artifactId>mappics</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mappics</name>

    <properties>
        <java.version>21</java.version>
        <spring-cloud-gcp.version>8.1.1</spring-cloud-gcp.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <pitest.version>1.25.8</pitest.version>
        <pitest-junit5.version>1.2.3</pitest-junit5.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.google.cloud</groupId>
                <artifactId>spring-cloud-gcp-dependencies</artifactId>
                <version>${spring-cloud-gcp.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Health checks for Cloud Run startup/liveness probes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- GCP base -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>spring-cloud-gcp-starter</artifactId>
        </dependency>

        <!-- Cloud Trace — exports Micrometer Tracing spans to GCP Cloud Trace -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>spring-cloud-gcp-starter-trace</artifactId>
        </dependency>

        <!-- Brave tracing auto-configuration (provides the io.micrometer.tracing.Tracer
             bean). Spring Boot 4 extracted this out of spring-boot-starter-actuator into
             its own module; gcp-starter-trace brings the Brave bridge but not the autoconfig. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>

        <!-- Google Cloud Storage -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>spring-cloud-gcp-starter-storage</artifactId>
        </dependency>

        <!-- Firestore -->
        <dependency>
            <groupId>com.google.cloud</groupId>
            <artifactId>google-cloud-firestore</artifactId>
        </dependency>

        <!-- EXIF extraction -->
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>2.21.0</version>
        </dependency>

        <!-- Image resizing -->
        <dependency>
            <groupId>com.sksamuel.scrimage</groupId>
            <artifactId>scrimage-core</artifactId>
            <version>4.6.7</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest slice — moved to its own module in Spring Boot 4 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SimpleTracer test double for asserting on emitted spans (version managed by Spring Boot BOM) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers (versions managed by Spring Boot BOM) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>gcloud</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- Docker Desktop 4.78+ enforces API 1.40 minimum on most endpoints.
                             The shaded docker-java inside Testcontainers defaults to 1.32.
                             Setting api.version here overrides that default in the shaded config. -->
                        <api.version>1.47</api.version>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Mutation testing (PIT). On demand only: `make mutation` or
                 `./mvnw test-compile pitest:mutationCoverage`. Report in target/pit-reports. -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest-junit5.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.antodippo.mappics.*</param>
                    </targetClasses>
                    <excludedClasses>
                        <!-- Bootstrap / Spring wiring — nothing to assert on -->
                        <param>com.antodippo.mappics.MappicsApplication</param>
                        <param>com.antodippo.mappics.infrastructure.persistence.PersistenceConfiguration</param>
                        <param>com.antodippo.mappics.infrastructure.storage.StorageConfiguration</param>
                        <!-- Local-dev-only scaffolding -->
                        <param>com.antodippo.mappics.infrastructure.LocalConfiguration</param>
                        <param>com.antodippo.mappics.infrastructure.LocalDevSeeder</param>
                        <param>com.antodippo.mappics.infrastructure.http.HTTPClientForLocalDev</param>
                        <param>com.antodippo.mappics.infrastructure.api.LocalImageController</param>
                        <!-- Covered only by Docker/GCP integration tests, which PIT doesn't run -->
                        <param>com.antodippo.mappics.infrastructure.persistence.GalleryRepositoryUsingFirestore</param>
                        <param>com.antodippo.mappics.infrastructure.storage.GalleryFileStorageWithGoogleStorage</param>
                        <param>com.antodippo.mappics.infrastructure.http.HTTPClientWithJavaHttpClient</param>
                        <param>com.antodippo.mappics.infrastructure.job.ImportJobRunner</param>
                    </excludedClasses>
                    <!-- Unit tests only: ITs need Docker, and the context-load test
                         would drag the full Spring context into every mutant run -->
                    <excludedGroups>
                        <param>integration</param>
                    </excludedGroups>
                    <excludedTestClasses>
                        <param>com.antodippo.mappics.MappicsApplicationTest</param>
                        <param>*IT</param>
                    </excludedTestClasses>
                    <threads>4</threads>
                    <!-- Fail below 85% killed mutations (88% as of the first hardening pass) -->
                    <mutationThreshold>85</mutationThreshold>
                    <timestampedReports>false</timestampedReports>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
